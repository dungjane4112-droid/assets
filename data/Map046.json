{"id":1,"name":"Naomi","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"character1.2","direction":8,"pattern":1,"characterIndex":1},"list":[{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["*I give her a little slap on the ass* hey"]},{"code":213,"indent":0,"parameters":[0,2,false]},{"code":231,"indent":0,"parameters":[1,"Pr_08_02",0,0,650,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["You finally arrived! It was taking you long enough."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["It was difficult; we were hunted for a long time before we managed to get here."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["So what did you find out in"]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,450,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["Well, our new enemies are all over the city; they have a lot of people."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Damn, then we'll have a lot of work to do, huh?"]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,450,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["You can bet on it, from what I've discovered there are 4 leaders at that time, we barely know who they "]},{"code":401,"indent":0,"parameters":["are but that's the information we have."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["4 hmm... where do we even begin? They probably want us dead, right?"]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,450,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["Well, there's a warehouse dangerously close to the house Stella mentioned... I went there and there are some hostile girls."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["From what I've heard, they're the ones defending this area of ​​the city... "]},{"code":401,"indent":0,"parameters":["if we don't stop them, we'll have a problem."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["It's a start, I can go there and see what I can do."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Hey, where's Mia? I don't see her."]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,450,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["Well, about that, I lost it in the shed... you..."]},{"code":401,"indent":0,"parameters":["could you please get it back?"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["That's why you want me to go there, right?"]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,450,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["also....please"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Okay then, let's not waste time, let's go there now."]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"ind