{"id":3,"name":"evento","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":223,"indent":0,"parameters":[[0,0,0,0],1,true]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["After a few hours, Olivia and Elizabeth will come to see us."]},{"code":222,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Pr_6_01",0,0,700,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["Okay, Stella ended up falling asleep."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["However, we managed to get the information we needed; Sophia, her daughter, is in a building not too far from here."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_3_01",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["So you can expect there to be people inside protecting her."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["There are dangerous people involved in this."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_6_01",0,0,700,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["So if we're going to rescue the little fox, we'll have to be very quick."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_08_01",0,0,700,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["Do we have any information about this building?"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_3_01",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["which should have some guards"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["My boy, you're going to go in there alone and get Sophia back."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"Zoe/Chloe"]},{"code":401,"indent":0,"parameters":["ALONE!!??"]},{"code":213,"indent":0,"parameters":[9,5,false]},{"code":213,"indent":0,"parameters":[7,5,false]},{"code":231,"indent":0,"parameters":[1,"Pr_1_02",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Zoe"]},{"code":401,"indent":0,"parameters":["Why? We're going with him."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_3_01",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["I know you all want to protect love, and so do we, actually everyone here... but because he's human, and especially a male, "]},{"code":401,"indent":0,"parameters":["he has an advantage against anthro he faces."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["Just smelling it will make them completely disoriented...and they will probably go into heat."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["If either of them is with him, our advantage will be used against us because they attacked you two, "]},{"code":401,"indent":0,"parameters":["or anyone else near him, without thinking."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_3_01",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["Therefore, without further discussion, I'm not going to risk my girls' lives... and I know my boy can do it alone."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Okay, nobody needs to worry, I'll go and save her... and I'll be back safely, I promise."]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Zoe, Chloe, and Naomi grumble about me going alone, afraid I'll get hurt."]},{"code":231,"indent":0,"parameters":[1,"Pr_6_02",0,0,400,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["Everyone stop this, \\n[1]! He's ours, we have to trust him. Olivia trained him for this. "]},{"code":401,"indent":0,"parameters":["I know we've always fought together, but now it's a different."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["We'll all go together along the way, but he'll brake on his own; Olivia will stay and take care of Stella."]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":201,"indent":0,"parameters":[0,168,3,9,0,0]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":9,"y":12},
