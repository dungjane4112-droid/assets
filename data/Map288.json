{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"character1.4","direction":4,"pattern":1,"characterIndex":0},"list":[{"code":213,"indent":0,"parameters":[0,1,true]},{"code":231,"indent":0,"parameters":[1,"Pr_20_01",0,0,600,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"???"]},{"code":401,"indent":0,"parameters":["You finally arrived."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["I'm Jessie, and you're welcome for your help. I know that without me, "]},{"code":401,"indent":0,"parameters":["you two wouldn't have gotten out of there."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Now that I've helped you, I have a req---"]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_2_02",0,0,400,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["Hey, hey, slow down—as far as we know, you were with our enemies, and now you come asking for things."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["So you better explain yourself properly, dammit."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_20_01",0,0,600,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Right, sorry..."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["I'm not with the lady, don't worry... I'm just helping Alice, you must know her, she's my mother."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Alice? Is she your mother?"]},{"code":231,"indent":0,"parameters":[1,"Pr_20_01",0,0,600,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Hehehe, yeah—an adopted..."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":[" At our shop, I'm the one who goes out and sources the things we sell."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Well, I was gathering some things to take to the shop, but I ran into some problems... "]},{"code":401,"indent":0,"parameters":["Mom told me I could ask you for help."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Then I saw that you had been captured and decided to help."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_2_02",0,0,400,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["*sniff* *sniff* Hmm... you don't smell like a lie... and you have a faint scent of rabbit."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["I think we can trust her, master..."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Okay, what do you want?"]},{"code":231,"indent":0,"parameters":[1,"Pr_20_01",0,0,600,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Well, I was gathering some things and hid them near the hospital... "]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["but some girls found them and stashed them in a room nearby... I wanted your help to get them back."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["In exchange, I'll help you get to the third floor, where Lady is actually hiding."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["So, do we have a deal? I think it's fair for both of us, don't you?"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Yeah, I really don't have a better idea of ​​how to get to her... we have a deal, Jessie."]},{"code":231,"indent":0,"parameters":[1,"Pr_20_01",0,0,600,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["Perfect, I'll go with you; that way we'll get it done faster."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Jessie"]},{"code":401,"indent":0,"parameters":["I don't have all these muscles for nothing. I know how to fight well too."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_2_02",0,0,400,0,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["Hmm... what a show-off...."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["Let's get on with it, then."]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["Jessie joins the team."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":129,"indent":0,"parameters":[12,0,false]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid"