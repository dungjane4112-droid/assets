{"id":3,"name":"eliza","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"character1.1","direction":2,"pattern":1,"characterIndex":7},"list":[{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["So what are we going to do now? We'll probably have some really annoying enemies now."]},{"code":213,"indent":0,"parameters":[4,2,true]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["Yes, that is, if they haven't followed us all the way here, I still think something is watching us in the forest."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Stella"]},{"code":401,"indent":0,"parameters":["Sorry for only causing problems."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Come on, let's not stay like this, it's pointless, we have to make a plan."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Naomi"]},{"code":401,"indent":0,"parameters":["We can go to the city and hide there."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Stella"]},{"code":401,"indent":0,"parameters":["I...I know of a house...it's empty, it's big, it could hide us."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["This sounds like a plan."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["Stella, why did they want you and your daughter?"]},{"code":213,"indent":0,"parameters":[6,6,true]},{"code":101,"indent":0,"parameters":["",0,1,2,"Stella"]},{"code":401,"indent":0,"parameters":["I...i don't know."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["My concern is if they want \\n[1] now, we've been hiding it from large groups like this for a long time."]},{"code":213,"indent":0,"parameters":[8,2,true]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["What do you want to do, little goat?"]},{"code":213,"indent":0,"parameters":[1,5,false]},{"code":213,"indent":0,"parameters":[7,6,false]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["Okay, let's do this: Jack, Chloe, Zoe, Luna, and Sophia will go to that house you mentioned... and Naomi will "]},{"code":401,"indent":0,"parameters":["go ahead of everyone and try to find out something."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Stella"]},{"code":401,"indent":0,"parameters":["And are we just going to stay here?"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["Yes, if we're being hunted, they'll come to the camp first; we'll be the distraction... you want to defend your "]},{"code":401,"indent":0,"parameters":["daughter, and I want to protect mine."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Are you sure you're okay?"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Elizabeth"]},{"code":401,"indent":0,"parameters":["My sweetie, nothing in this world can defeat Olivia and me together. You can rest easy, call the girls and get ready to go!"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["That's right, my good boy, don't worry about the moms here, we'll come looking for you in 3 days."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Olivia"]},{"code":401,"indent":0,"parameters":["then you can go"]},{"code":213,"indent":0,"parameters":[7,4,false]},{"code":213,"indent":0,"parameters":[1,7,false]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Okay, we'll go, but it's good that you show up there in three days."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Stella"]},{"code":401,"indent":0,"parameters":["Here's a map showing where the house is located."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Great, it's not too far from here, about a 4-hour walk."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["I'm going to go and get things ready."]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["I called the girls and we grabbed our things and headed towards the house that Stella mentioned."]},{"code":101,"indent":0,"parameters":["",0,1,1,""]},{"code":401,"indent":0,"parameters":["And so began the greatest journey of my life."]},{"code":201,"indent":0,"parameters":[0,44,7,12,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":5,"y":13},
