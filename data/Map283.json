{"id":1,"name":"ivy","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"character1.3","direction":2,"pattern":1,"characterIndex":2},"list":[{"code":231,"indent":0,"parameters":[1,"Pr_15_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Ivy"]},{"code":401,"indent":0,"parameters":["Look who it is, the giant kitty! I finally thought you were lost."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Ivy"]},{"code":401,"indent":0,"parameters":["And I see you brought a bodyguard, hehe."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Ivy! So, do you know Xena?"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Ivy"]},{"code":401,"indent":0,"parameters":["Oh, definitely... half of our income comes from selling food to that girl."]},{"code":231,"indent":0,"parameters":[1,"Pr_16_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Xena"]},{"code":401,"indent":0,"parameters":["Okay, rabbit... enough talk, you brought my load."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_15_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Ivy"]},{"code":401,"indent":0,"parameters":["Sure, sweetie, 900 pounds of meat isn't easy to come by."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_16_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Xena"]},{"code":401,"indent":0,"parameters":["Well, that's why I pay you well."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1] (thinking)"]},{"code":401,"indent":0,"parameters":["900 pounds—that's a hell of a lot of meat for just one girl."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Will you need help taking it home?"]},{"code":231,"indent":0,"parameters":[1,"Pr_16_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Xena"]},{"code":401,"indent":0,"parameters":["That won't be necessary; I can carry it without any problem."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Xena"]},{"code":401,"indent":0,"parameters":["Alright, Ivy, let's go—I don't have all day, and I'm hungry."]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[1,"Pr_15_01",0,0,600,0,70,70,255,0]},{"code":101,"indent":0,"parameters":["",0,1,2,"Ivy"]},{"code":401,"indent":0,"parameters":["Alright, let's go—it's not far; I hid it somewhere nearby."]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["You follow Ivy to pick up Xena's delivery—a huge, refrigerated box. She lifts it effortlessly, and the two of you head back home."]},{"code":129,"indent":0,"parameters":[11,1,false]},{"code":201,"indent":0,"parameters":[0,280,10,10,8,0]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true}],"x":17,"y":12}
