0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Hehe, right—looks like I won't be able to change your mind."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Alright then, take my rifle; you're going to use it."]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\n[1]"]},{"code":401,"indent":0,"parameters":["Do you still remember what I taught you?"]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["Come on, Master, I'm not that useless."]},{"code":221,"indent":0,"parameters":[]},{"code":129,"indent":0,"parameters":[3,0,false]},{"code":201,"indent":0,"parameters":[0,249,5,9,0,0]},{"code":101,"indent":0,"parameters":["",0,1,2,""]},{"code":401,"indent":0,"parameters":["You jump into the hole."]},{"code":101,"indent":0,"parameters":["",0,1,2,"Chloe"]},{"code":401,"indent":0,"parameters":["Alright, Master, here I go... just catch me, please."]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":5,"y":3},
